# SOLO para correr en local/Docker. En Databricks Apps no se usa (la app tiene su propia identidad).
# Copia este archivo como .env y llena tus valores. NUNCA subas .env a GitHub.
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXX
SERVING_ENDPOINT=m5-demand
ENDPOINT_TIMEOUT=60
